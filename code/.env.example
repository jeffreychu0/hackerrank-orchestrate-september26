OPENAI_API_KEY=
# Set a Responses API model available to your project (example: gpt-5.2).
OPENAI_MODEL=gpt-5.2
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=2048

# Anthropic provider (used with --provider anthropic). The key may be left blank:
# the SDK then falls back to ANTHROPIC_AUTH_TOKEN, an `ant auth login` profile,
# or workload identity federation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_TIMEOUT_SECONDS=120
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_MAX_OUTPUT_TOKENS=4096
# Optional: low | medium | high | xhigh | max. Unset sends the API default.
ANTHROPIC_EFFORT=
